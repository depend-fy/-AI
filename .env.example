# ============================================================
# 智鉴 AI（VeriMind AI）配置模板
# ------------------------------------------------------------
# 使用方法：
#   1. 把本文件复制成 .env      （PowerShell: Copy-Item .env.example .env）
#   2. 按需填写。只有带【密钥】标记的项是必须自己提供的。
#   3. .env 已被 .gitignore 忽略，绝不会提交到 Git。
#
# 所有变量都以 VERIMIND_ 开头，避免和你电脑上其他工具的变量重名。
# ============================================================

# ---------- 应用信息 ----------
VERIMIND_APP_VERSION=0.1.0

# ---------- 大模型（阶段 3 才真正用得上；留空也能跑，会自动进入"离线模拟"模式）----------
# 可选 provider：mock（离线模拟，默认） / deepseek / openai / moonshot / zhipu / dashscope / ollama
VERIMIND_LLM_PROVIDER=mock

# 各家的 OpenAI 兼容地址（换供应商只改这几行，代码不用动）
#   DeepSeek : https://api.deepseek.com/v1        模型 deepseek-chat
#   智谱 GLM : https://open.bigmodel.cn/api/paas/v4  模型 glm-4-plus
#   Kimi     : https://api.moonshot.cn/v1         模型 moonshot-v1-8k
#   通义千问 : https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
#   本地Ollama: http://127.0.0.1:11434/v1         模型 qwen2.5:7b（无需密钥）
VERIMIND_LLM_BASE_URL=https://api.deepseek.com/v1
VERIMIND_LLM_MODEL=deepseek-chat

# 【密钥】你的大模型 API Key。留空 = 离线模拟模式。
VERIMIND_LLM_API_KEY=

# ---------- 独立复核员模型（可选，但强烈建议）----------
# 作用：**只用于"复核修正"这一步**。修正员用主模型，复核员用另一个模型，
#       这样"改的人"和"检查改得对不对的人"才不是同一个。界面顶部会把运行模式
#       从「单模型多角色模拟」升级为「多模型协同」。
#
# 三种配法（任选其一）：
#   ① 跨厂商（最独立，推荐）：provider / base_url / model / API_KEY 都填
#        zhipu    : https://open.bigmodel.cn/api/paas/v4      模型 glm-4-plus
#        moonshot : https://api.moonshot.cn/v1                 模型 moonshot-v1-8k
#        dashscope: https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
#        openai   : https://api.openai.com/v1                  模型 gpt-4o-mini
#   ② 同一家的另一个模型（最省事）：provider 与主模型相同，只换 model，
#        API_KEY 可以留空（会自动复用主模型密钥）。
#        例：主模型 deepseek-chat → 复核员 deepseek-reasoner
#   ③ 本地 Ollama（完全离线、零成本）：provider=ollama，
#        base_url=http://127.0.0.1:11434/v1，模型 qwen2.5:7b，API_KEY 留空
#
# 留空则复核由主模型兼任——报告与界面会如实写明「复核独立性有限」。
VERIMIND_LLM_REVIEWER_PROVIDER=
VERIMIND_LLM_REVIEWER_BASE_URL=
VERIMIND_LLM_REVIEWER_MODEL=
VERIMIND_LLM_REVIEWER_API_KEY=

# ---------- 调用与成本控制 ----------
VERIMIND_LLM_TIMEOUT_SECONDS=60          # 单次调用超时（秒）
VERIMIND_LLM_MAX_RETRIES=2               # 网络类错误重试次数
VERIMIND_LLM_CACHE_ENABLED=true          # 相同输入复用缓存结果（重跑不花钱）
VERIMIND_LLM_MAX_CALLS_PER_RUN=30        # 单次检测的模型调用硬上限（防成本失控）

# ---------- 成本估算（可选）----------
# **故意留空**：没有单价就只在报告里显示真实 token 与耗时，绝不编一个金额出来。
# 单价请到供应商官网查，单位是"元 / 百万 token"：
#   DeepSeek 开放平台 → 定价页；填好后报告才会显示成本，并注明单价来源是你自己配置的。
VERIMIND_LLM_PRICE_PROMPT_PER_MTOK=
VERIMIND_LLM_PRICE_COMPLETION_PER_MTOK=

# ---------- 外部文献检索（全部免密钥）----------
VERIMIND_RETRIEVE_ENABLED=true
VERIMIND_RETRIEVAL_MAILTO=your-email@example.com   # 建议填真实邮箱：Crossref/OpenAlex 的"礼貌池"会更快更稳
VERIMIND_RETRIEVAL_TIMEOUT_SECONDS=20
VERIMIND_RETRIEVAL_MIN_INTERVAL_SECONDS=1.0        # 同一来源的请求最小间隔，避免被限流
VERIMIND_RETRIEVAL_CACHE_HOURS=24                  # 同一检索式缓存多久
VERIMIND_RETRIEVAL_MAX_QUERIES_PER_RUN=12          # 单次检测最多执行多少个检索查询
VERIMIND_RETRIEVAL_MAX_RETRIES=1                   # 检索失败（限流/5xx/超时）重试次数

# ---------- 输入与流程限制 ----------
VERIMIND_MAX_INPUT_CHARS=3000            # 单次检测最大文本长度
VERIMIND_MAX_CLAIMS=8                    # 单次检测最多核验多少条主张

# ---------- 数据保存 ----------
VERIMIND_SAVE_RUNS=true                  # 是否把检测记录存到本地 SQLite
